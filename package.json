{
  "name": "parley-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "ts",
    "examples",
    "bench",
    "site",
    "deploy/demo"
  ],
  "scripts": {
    "build": "npm run build -w parley-protocol",
    "test": "npm test -w parley-protocol",
    "demo": "npm run build && node examples/demo.ts",
    "bench": "npm run build && node bench/run.ts && node bench/estimator.ts",
    "site": "npm run build -w parley-site"
  },
  "engines": {
    "node": ">=22.18"
  }
}
